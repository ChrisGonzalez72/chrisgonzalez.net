---
import Icon from './Icon.astro';
import type { Faq } from '../config/apps';
interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <Icon name="chevron-down" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 2px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    flex: none;
    color: var(--text-3);
    transition: transform 0.25s var(--ease);
  }
  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  details p {
    padding: 0 2px 22px;
    color: var(--text-2);
    max-width: 68ch;
  }
</style>
