---
/** The ChrisGonzalez.net mark: an open "C" ring with a record dot. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="var(--text)"></rect>
  <path d="M21.6 11.2A7.2 7.2 0 1 0 21.6 20.8" fill="none" stroke="var(--bg)" stroke-width="3.2" stroke-linecap="round"></path>
  <circle cx="22.6" cy="16" r="2.4" fill="#E5484D"></circle>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
