---
import ProductPage from '../../../components/ProductPage.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Icon from '../../../components/Icon.astro';
import { getApp } from '../../../config/apps';

const app = getApp('on-record');
const macShot = app.features.find((f) => f.shot?.frame === 'window')!.shot!;

const steps = [
  {
    icon: 'mic',
    title: 'Record anywhere',
    body: 'On your Mac, iPhone, iPad or Apple Watch — or import audio files you already have.',
  },
  {
    icon: 'sparkle',
    title: 'Your Mac writes it up',
    body: 'Transcription, speaker detection and the AI writing run on your Mac, with models you download once.',
  },
  {
    icon: 'check',
    title: 'Check, ask, share',
    body: 'Every point links to its moment. Ask questions across meetings. Export when you choose.',
  },
] as const;

const devices = [
  {
    icon: 'mac',
    name: 'Mac',
    points: [
      'Records your microphone together with the call audio from Zoom, Teams, Webex or any other app.',
      'Imports audio files you already have.',
      'Does all the transcription and writing up.',
    ],
  },
  {
    icon: 'iphone',
    name: 'iPhone',
    points: [
      'Start in one tap from the app, a Home Screen widget, Control Center, the Action button or Siri.',
      'Keeps recording on the Lock Screen with a Live Activity.',
    ],
  },
  {
    icon: 'ipad',
    name: 'iPad',
    points: ['Record in the app, even offline.', 'Recordings go to your Mac when the iPad is back online.'],
  },
  {
    icon: 'watch',
    name: 'Apple Watch',
    points: ['Start, pause and stop from your wrist.', 'Mark important moments while you record.'],
  },
] as const;

const organize = [
  { icon: 'users', text: 'Name speakers once and On Record suggests them in future meetings.' },
  { icon: 'folder', text: 'Group meetings into series, projects and courses.' },
  { icon: 'list', text: 'Browse everyone you meet with and every decision across your meetings.' },
  { icon: 'book', text: 'Teach it names and acronyms with your own vocabulary.' },
  { icon: 'share', text: 'Export a meeting as a PDF or text, with or without the transcript and audio.' },
] as const;
---

<ProductPage app={app} ogImage="/og/on-record.png">
  <div slot="hero-visual" class="or-hero">
    <DeviceShot shot={macShot} class="or-mac" eager sizes="(max-width: 900px) 92vw, 620px" />
    <DeviceShot shot={app.hero} class="or-phone" eager sizes="(max-width: 900px) 36vw, 220px" />
  </div>

  <section slot="after-overview" class="section how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="h2">Capture. Understand. Remember.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="card" data-reveal>
              <span class="step-n">0{i + 1}</span>
              <span class="step-icon">
                <Icon name={s.icon} size={22} />
              </span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Fragment slot="after-features">
    <section class="section" aria-labelledby="anywhere-title">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Record anywhere</p>
          <h2 id="anywhere-title" class="h2">One app on every Apple device you carry.</h2>
          <p class="lead">One App Store listing covers Mac, iPhone, iPad and Apple Watch. Recordings from any of them end up written up on your Mac.</p>
        </div>
        <ul class="devices grid">
          {
            devices.map((d) => (
              <li class="card" data-reveal>
                <Icon name={d.icon} size={26} />
                <h3 class="h3">{d.name}</h3>
                <ul>
                  {d.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section privacy-band" aria-labelledby="private-title">
      <div class="wrap band-grid">
        <div class="section-head">
          <p class="eyebrow"><Icon name="lock" size={14} /> Privacy</p>
          <h2 id="private-title" class="h2">Your meetings stay yours.</h2>
          <p class="lead">
            No On Record servers. No account. No meeting bot. Your meetings are never used for advertising, tracking or AI training.
          </p>
          <a class="btn btn-ghost" href="/apps/on-record/privacy/">Read the privacy policy <Icon name="arrow-right" /></a>
        </div>
        <ul class="band-list">
          {
            app.privacyHighlights.map((h) => (
              <li>
                <Icon name="shield" size={20} />
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="organize-title">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Keep it organized</p>
          <h2 id="organize-title" class="h2">A memory that grows with every meeting.</h2>
        </div>
        <ul class="organize grid grid-3">
          {
            organize.map((o) => (
              <li data-reveal>
                <Icon name={o.icon} size={22} />
                <p>{o.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="callout consent">
          <Icon name="info" />
          <span>Please follow the law where you are and get people’s consent before recording them.</span>
        </p>
      </div>
    </section>
  </Fragment>
</ProductPage>

<style>
  .or-hero {
    position: relative;
    width: 100%;
    padding: 0 0 48px 64px;
  }
  .or-hero :global(.or-phone) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 38%;
    max-width: 220px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .steps li {
    display: grid;
    gap: 10px;
    padding: 28px;
    align-content: start;
  }
  .step-n {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }
  .step-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--app-accent) 14%, transparent);
    color: var(--app-accent-text);
    margin-bottom: 6px;
  }
  .devices {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .devices > li {
    display: grid;
    gap: 12px;
    padding: 26px;
    align-content: start;
  }
  .devices > li > :global(svg) {
    color: var(--app-accent-text);
  }
  .devices ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
    color: var(--text-2);
    font-size: 15.5px;
  }
  .privacy-band {
    background:
      radial-gradient(50% 80% at 0% 50%, color-mix(in srgb, var(--app-accent) 12%, transparent), transparent 70%),
      var(--bg-soft);
  }
  .band-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .band-grid .section-head {
    margin: 0;
    justify-items: start;
  }
  .band-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .band-list li {
    display: flex;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    font-size: 17px;
    font-weight: 500;
  }
  .band-list :global(svg) {
    flex: none;
    color: var(--app-accent-text);
  }
  .organize {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    gap: 28px 32px;
  }
  .organize li {
    display: grid;
    gap: 10px;
    color: var(--text-2);
  }
  .organize :global(svg) {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .steps,
    .band-grid {
      grid-template-columns: 1fr;
    }
    .or-hero {
      padding-left: 18%;
    }
  }
</style>
