---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated?: string;
  crumbs?: { label: string; href: string }[];
}
const { title, description, eyebrow, updated, crumbs } = Astro.props;
const updatedText = updated
  ? new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="section top">
    <div class="wrap wrap-narrow">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <header class="head">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="h2">{title}</h1>
        {updatedText && <p class="subtle">Last updated {updatedText}</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .top {
    padding-top: 32px;
  }
  .head {
    display: grid;
    gap: 12px;
    margin: 32px 0 40px;
  }
</style>
